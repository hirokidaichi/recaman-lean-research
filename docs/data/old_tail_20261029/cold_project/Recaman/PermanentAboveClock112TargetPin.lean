/-- The same witness data as a small piecewise-affine lookup.  The exceptional
input 223 is intentionally irrelevant: every use carries `value ≠ 223`. -/
def clock112TargetOccurrenceWitnessTime (value : Nat) : Nat :=
  if value ≤ 157 then 380 - 2 * value
  else if value ≤ 164 then 2 * value - 228
  else if value ≤ 180 then 667 - 2 * value
  else if value ≤ 204 then 1771 - 2 * value
  else if value ≤ 222 then 3032 - 2 * value
  else if value ≤ 228 then 2 * value - 381
  else if value ≤ 254 then 743 - 2 * value
  else if value = 255 then 1345
  else if value ≤ 257 then 707 - 2 * value
  else if value = 258 then 119
  else if value ≤ 260 then 2 * value - 397
  else 109

/-- The expanded table and the compressed lookup agree.  This is only a
small arithmetic/list check and does not unfold the Recamán sequence. -/
theorem clock112TargetOccurrenceWitnessTimes_match_lookup :
    clock112TargetOccurrenceWitnessTimes.all (fun entry =>
      clock112TargetOccurrenceWitnessTime entry.1 == entry.2) = true := by
  decide

/-- The exact residual expected from a balanced trace checker.  The checker
must authenticate one checkpoint through clock 2622 and all 108 explicit
chronological-array lookups. -/
structure Clock112ExactHistoryCertificate where
  machine : TraceMachine
  represents : machine.Represents (stateAt 2622)
  witness_lookup : ∀ value, 153 ≤ value → value ≤ 261 → value ≠ 223 →
    machine.values[clock112TargetOccurrenceWitnessTime value]? = some value

namespace TerminalExactDischargeReplayCertificate

variable {target start : Nat} {parent : PhaseSearchNode}
variable {source : PermanentTailDischargeReturnCertificate target start parent}

/-- Once the explicit exact-history residual is authenticated, a clock-112
replay has exactly one possible missing target: 223. -/
theorem target_eq_223_of_crossingTime_eq_112
    (r : TerminalExactDischargeReplayCertificate source)
    (hclock : r.crossingTime = 112)
    (history : Clock112ExactHistoryCertificate) :
    target = 223 := by
  have hpins := r.clock112_historical_downcross_pins hclock
  by_cases heq : target = 223
  · exact heq
  · have hlow : 153 ≤ target := by omega
    have hhigh : target ≤ 261 := hpins.2.2.2
    have hlookup := history.witness_lookup target hlow hhigh heq
    have hoccurs := history.represents.occurs_of_value_lookup hlookup
    exact False.elim (r.target_missing hoccurs)

end TerminalExactDischargeReplayCertificate

end

