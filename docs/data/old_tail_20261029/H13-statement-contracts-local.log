ThreeRunOldTargetGap.three_run_old_target_free_gap_int : ∀ (e : Int → Bool) (p : Int) (n a t h M m L s T j : Nat)
  (w : List Bool),
  BlockWord w →
    segment e p n = w ++ List.replicate a true →
      t < n →
        1 ≤ M →
          1 ≤ m →
            1 ≤ L →
              1 ≤ s →
                1 ≤ T →
                  (∀ (x : Nat), n ≤ x → x < n + h → e (p + ↑x) = false) →
                    (∀ (i : Nat), i < M → e (p + ↑(n + h + i)) = true) →
                      (∀ (x : Nat), n + h + M ≤ x → x < n + h + M + m → e (p + ↑x) = false) →
                        (∀ (i : Nat), i < L → e (p + ↑(n + h + M + m + i)) = true) →
                          (∀ (x : Nat), n + h + M + m + L ≤ x → x < n + h + M + m + L + s → e (p + ↑x) = false) →
                            (∀ (i : Nat), i < T → e (p + ↑(n + h + M + m + L + s + i)) = true) →
                              endableCount e p n = subtractionCount e p n →
                                (∀ (u : Nat),
                                    n < u →
                                      u ≤ n + h + M + m + L + s + T + j →
                                        endableCount e p u + 1 ≤ subtractionCount e p u) →
                                  (∀ (x : Nat),
                                      n + h + M + m + L + s + T ≤ x →
                                        x < n + h + M + m + L + s + T + j → e (p + ↑x) = false) →
                                    Endable e p (p + ↑(n + h + M + m + L + s + T + j)) →
                                      P2
                                          (past e (p + ↑(n + h + M + m + L + s + T + j))
                                            (n + h + M + m + L + s + T + j - t)) →
                                        j + 1 ≤
                                          countP (fun x => e x = true ∧ ¬Endable e p x) (p + ↑n) (h + M + m + L + s + T)
