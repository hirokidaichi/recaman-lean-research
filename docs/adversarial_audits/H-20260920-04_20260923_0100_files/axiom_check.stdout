                          (Recaman.SharpPeriodicSupply.phase 16
                            (15 -
                              ↑(Recaman.LagSevenDonorCoverage.oldestOffset
                                  (Recaman.LeadingRunSupply.past Recaman.ShortTightDonorAvoidance.donorLength15Stream 15
                                    15)))) =
                        []
'Recaman.ShortTightDonorAvoidance.nonminimal_donor_length15_counterexample' depends on axioms: [propext, Quot.sound]
