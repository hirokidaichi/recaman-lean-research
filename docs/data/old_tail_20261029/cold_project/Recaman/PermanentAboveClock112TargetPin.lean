/-! # Clock-112 target pin

The clock-112 replay band is `152 < target ∧ target ≤ 261`.  The residual
certificate below is designed for an external exact-history generator and a
kernel-sound chunked trace checker through time 2622.  A
separate explicit table records one occurrence clock for every value in that
band except 223.  Thus the replay's global `target_missing` field leaves 223
as the unique possible target.

The external data become usable only after the checker authenticates every
orbit branch and every witness-array lookup.  No native evaluation is used.
-/

/-- A lookup in the chronological value array of an authenticated checkpoint
gives an occurrence in the ordinary Recamán history. -/
theorem TraceMachine.Represents.occurs_of_value_lookup
    {machine : TraceMachine} {horizon time value : Nat}
    (hrep : machine.Represents (stateAt horizon))
    (hlookup : machine.values[time]? = some value) :
    ∃ witness, a witness = value := by
  have hparts := getElem?_eq_some_iff.mp hlookup
  have hmem : value ∈ machine.values.toList := by
    rw [← hparts.2]
    exact Array.getElem_mem_toList hparts.1
  have hreverse : value ∈ machine.values.toList.reverse :=
    List.mem_reverse.mpr hmem
  rw [hrep.values_reverse] at hreverse
  have hhistory : value ∈ valuesThrough horizon := by
    exact hreverse
  rcases mem_valuesThrough_iff.mp hhistory with ⟨witness, _, hvalue⟩
  exact ⟨witness, hvalue⟩

